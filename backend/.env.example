# FailureLoop Environment Configuration
PORT=4000

# Hindsight Cloud / Self-hosted Memory Layer
HINDSIGHT_API_KEY=<supplied separately>
HINDSIGHT_BASE_URL=https://api.hindsight.vectorize.io

# Primary LLM Provider (Groq)
GROQ_API_KEY_PRIMARY=<supplied separately>

# Secondary Groq Key for 429 Rate-Limit Fallback
GROQ_API_KEY_SECONDARY=<supplied separately>

# Cross-provider LLM Fallback (Google Gemini 2.5 Flash)
GEMINI_API_KEY_FALLBACK=<supplied separately>
